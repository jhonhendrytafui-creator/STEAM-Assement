# Copy to .env.local for local development. In production these are set in the
# hosting provider's dashboard (Netlify: Site configuration -> Environment
# variables), never committed.

# ── Supabase ────────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key, same page. Required: /api/precheck uses it to count the
# AI Pre-Check quota server-side, because students may no longer write to
# ai_precheck_usage themselves. Without it every pre-check returns 503.
# Server-side only — it bypasses RLS, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini ───────────────────────────────────────────
# https://aistudio.google.com/apikey — powers the AI Pre-Check, assessment,
# plagiarism detection, project classification and C5 question generation.
# The key must be able to serve at least one id in GEMINI_TEXT_MODELS
# (src/lib/gemini.ts); /api/debug-quota reports which one answered.
GEMINI_API_KEY=your-gemini-api-key

# ── Google Docs / Drive (project document generation) ───────
# Service account JSON on one line. Share the template document with the
# service account's client_email or /api/generate-doc returns 403.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Apps Script web app URL used as the document-generation fallback.
GOOGLE_APPSCRIPT_URL=https://script.google.com/macros/s/.../exec

# ── Site ────────────────────────────────────────────────────
# Public origin, used to build the Supabase auth callback URL.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
